{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hunter's Bestiary Aquatic Ecology Package",
  "type": "object",
  "required": [
    "schemaVersion",
    "canonicalDate",
    "species",
    "signs",
    "rumors",
    "books",
    "hunts",
    "complications",
    "harvests",
    "foodWeb",
    "regionalDistribution",
    "seasonalCalendar"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "canonicalDate": {
      "const": "0443-03-03"
    },
    "species": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "commonName",
          "taxonomy",
          "externalAnatomy",
          "physiology",
          "feedingEcology",
          "reproduction",
          "behavior",
          "habitat",
          "population",
          "humanInteraction",
          "actorPolicy"
        ]
      }
    },
    "signs": {
      "type": "array"
    },
    "rumors": {
      "type": "array"
    },
    "books": {
      "type": "array"
    },
    "hunts": {
      "type": "array"
    },
    "complications": {
      "type": "array"
    },
    "harvests": {
      "type": "array"
    },
    "foodWeb": {
      "type": "object"
    },
    "regionalDistribution": {
      "type": "object"
    },
    "seasonalCalendar": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33
    }
  },
  "additionalProperties": true
}
